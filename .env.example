# Server-only database configuration. Put real credentials in .env.local.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER.mongodb.net/
MONGODB_DB=theragurus
# Optional process-local DNS servers if local SRV/TXT resolution fails.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
# Use the public site origin in production; never trust a client-supplied origin.
APP_ORIGIN=http://localhost:3000
# Enable only behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Resend delivery (optional until the sender domain is verified).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Clerk customer sign-in. Create an application at https://dashboard.clerk.com
# and turn on Google under Configure → SSO connections. Restart after adding keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret from the Clerk webhook endpoint. Keep the real value in .env.local.
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

